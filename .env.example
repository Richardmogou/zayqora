# --- Database ---
POSTGRES_USER=zayqora
POSTGRES_PASSWORD=
POSTGRES_DB=zayqora
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/zayqora
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/zayqora_test

# --- Backend ---
ENVIRONMENT=development
SESSION_COOKIE_NAME=zayqora_session
SESSION_DAYS=14
CORS_ORIGINS=http://localhost:3000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
PUBLIC_RATE_LIMIT_MAX_REQUESTS=60
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
PAYMENT_WEBHOOK_SECRET=replace_with_random_32byte_secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
SITE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@zayqora.local
SMTP_USE_TLS=true

# --- Frontend ---
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
